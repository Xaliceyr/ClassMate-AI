# Configuração do ClassMate AI
# Cole sua chave do Google AI Studio (https://aistudio.google.com/apikey) depois do "=",
# sem aspas e sem espaços. Veja a seção 2 do README.
# NUNCA faça commit deste arquivo com a chave preenchida (veja a seção 8 do README).
GOOGLE_API_KEY=

# Modelos (opcionais: se ficarem vazios, o app usa estes padrões)
GEMINI_MODEL=gemini-3.5-flash-lite
EMBEDDING_MODEL=gemini-embedding-001
